<?xml version="1.0" encoding="UTF-8"?>
<!-- Template: a denormalized document for budget analysis and its real-time feed to OpenSearch.
     Grain: one document per BudgetItem. Shared fields across documents in the same index
     (organizationPartyId, glAccountId, periodFromDate) make cross-document aggregations possible. -->
<entity-facade-xml type="seed-initial">
    <dataDocuments dataDocumentId="AcmeBudgetLine" indexName="acme_budget" documentName="BudgetLine"
            primaryEntityName="mantle.other.budget.BudgetItem" documentTitle="${budgetId}:${budgetItemSeqId}">
        <fields fieldSeqId="01" fieldPath="budgetId"/>
        <fields fieldSeqId="02" fieldPath="budgetItemSeqId"/>
        <fields fieldSeqId="03" fieldPath="itemTypeEnumId"/>
        <fields fieldSeqId="04" fieldPath="glAccountId"/>
        <fields fieldSeqId="05" fieldPath="amount"/>
        <fields fieldSeqId="10" fieldPath="glAccount:accountName" fieldNameAlias="glAccountName"/>
        <fields fieldSeqId="11" fieldPath="glAccount:glAccountTypeEnumId"/>
        <fields fieldSeqId="20" fieldPath="budget:budgetTypeEnumId"/>
        <fields fieldSeqId="21" fieldPath="budget:statusId" fieldNameAlias="budgetStatusId"/>
        <fields fieldSeqId="22" fieldPath="budget:currencyUomId"/>
        <fields fieldSeqId="30" fieldPath="budget:timePeriod:partyId" fieldNameAlias="organizationPartyId"/>
        <fields fieldSeqId="31" fieldPath="budget:timePeriod:fromDate" fieldNameAlias="periodFromDate"/>
        <fields fieldSeqId="32" fieldPath="budget:timePeriod:thruDate" fieldNameAlias="periodThruDate"/>
        <conditions conditionSeqId="01" fieldNameAlias="budgetTypeEnumId" fieldValue="BudgetOperating"/>
    </dataDocuments>

    <!-- real-time push: any change to the entities in the document re-indexes it -->
    <moqui.entity.feed.DataFeed dataFeedId="AcmeBudgetFeed" dataFeedTypeEnumId="DTFDTP_RT_PUSH" indexOnStartEmpty="Y"
            feedName="ACME Budget Analysis" feedReceiveServiceName="org.moqui.search.SearchServices.index#DataDocuments"
            feedDeleteServiceName="org.moqui.search.SearchServices.delete#DataDocument">
        <documents dataDocumentId="AcmeBudgetLine"/>
    </moqui.entity.feed.DataFeed>
</entity-facade-xml>
