<?xml version="1.0" encoding="UTF-8"?>
<!-- Example: an AI agent as a party, following the convention in moqui-model "Automated agents as parties". -->
<entity-facade-xml type="seed-initial">
    <moqui.basic.Enumeration enumId="PcntAgentCard" enumTypeId="PartyContentType" description="A2A Agent Card"/>
    <mantle.party.Party partyId="ACME_AGENT_EXEC" pseudoId="EXECUTOR" partyTypeEnumId="PtyAutomatedAgent" ownerPartyId="ACME_CORP">
        <roles roleTypeId="Agent"/>
        <contents partyContentId="ACME_AGENT_EXEC_CARD" partyContentTypeEnumId="PcntAgentCard"
                contentLocation="dbresource://acme/agents/executor-agent-card.json"/>
    </mantle.party.Party>
    <mantle.party.PartyRelationship partyRelationshipId="ACME_AGENT_EXEC_AGT" relationshipTypeEnumId="PrtAgent"
            fromPartyId="ACME_AGENT_EXEC" fromRoleTypeId="Agent" toPartyId="ACME_CORP" toRoleTypeId="OrgInternal"
            fromDate="2026-01-01 00:00:00"/>
    <moqui.security.UserAccount userId="ACME_AGENT_EXEC" partyId="ACME_AGENT_EXEC" username="agent.executor"
            userFullName="ACME Executor Agent"/>
</entity-facade-xml>
